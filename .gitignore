# model weights and caches never go in git
*.gguf
*.safetensors
*.bin
.ollama/
# experiment output: dialogues, logs, transcripts (large; archived separately)
data/**
!data/README.md
!data/.gitkeep
# ...except the provenance records, which are a few kB each and are the whole point: a clone of
# this repository alone must be able to say exactly what was run. git does not descend into an
# excluded directory, so the run directories have to be un-ignored too.
!data/*/
!data/*/manifest.json
!data/*/judge-*.json
# the archive record (docs/REPRODUCIBILITY.md section 3), which says where the row files went, and the
# randomizer's assignment log that `run` copies beside the manifest
!data/*/archive.json
!data/*/SHA256SUMS
!data/*/assignment.json
# huge llama-server logs
llama-*.log
*.nohup.log
# python
__pycache__/
*.pyc
.venv/
venv/
env/
# editor / os
.DS_Store
.vscode/
.idea/
# secrets
.env
# pytest caches
harness/.pytest_cache/
.pytest_cache/
# lint and packaging output
.ruff_cache/
*.egg-info/
build/
dist/
